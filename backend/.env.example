# Copy to .env and load it into your shell before running the backend:
#   set -a && source .env && set +a
# The backend reads only the process environment; it never reads this file.

# --- Square ------------------------------------------------------------------
# Leave SQUARE_ACCESS_TOKEN empty to run without Square: the menu is served
# from the PocketBase cache, and checkout / catalog sync report 503.
SQUARE_ACCESS_TOKEN=
# sandbox | production
SQUARE_ENVIRONMENT=sandbox
SQUARE_LOCATION_ID=
# From the webhook subscription in the Square Developer Dashboard. The URL
# must match the subscription exactly (it is part of the signed payload).
# Both are required when SQUARE_ENVIRONMENT=production.
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=
# SQUARE_TIMEOUT=15s
# SQUARE_ALLOW_TIPPING=false
# SQUARE_CURRENCY=USD

# --- Storefront --------------------------------------------------------------
# Square redirects buyers to {PUBLIC_SITE_URL}/orders/{id} after paying.
PUBLIC_SITE_URL=http://localhost:3000

# --- Pickup ETA (see internal/services/eta) ----------------------------------
# ETA_BASE_PREP=2m     # fixed work per order that contains drinks
# ETA_PER_ITEM=90s     # work per drink
# ETA_BUFFER=2m        # hand-off slack added to every estimate
# ETA_CAPACITY=2       # drinks orders prepared in parallel

# --- Background reconciliation (cron syntax; empty disables) -----------------
# CATALOG_SYNC_CRON=*/30 * * * *
# ORDER_RECONCILE_CRON=*/5 * * * *
